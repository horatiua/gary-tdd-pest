{
  "require-dev": {
    "pestphp/pest": "^2.8",
    "symfony/var-dumper": "^5.4 || ^6.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "run-pest": "vendor/bin/pest"
  }
}
