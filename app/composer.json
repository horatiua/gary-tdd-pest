{
  "require-dev": {
    "pestphp/pest": "^2.13",
    "symfony/var-dumper": "^5.4 || ^6.0",
    "mockery/mockery": "^1.6",
    "pestphp/pest-plugin-type-coverage": "^2.8"
  },
  "require": {
    "ext-pdo": "*",
    "nikic/fast-route": "^1.3",
    "league/container": "^4.2",
    "firebase/php-jwt": "^6.11"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "run-pest": "vendor/bin/pest"
  }
}
